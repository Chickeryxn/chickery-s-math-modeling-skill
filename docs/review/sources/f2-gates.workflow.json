  "cards": [
    { "dot": "cyan", "title": "过门证据（引擎查存在与结构深度）", "items": ["G1：parse（goal+required_outputs）+ classification（primary_type）+ data 清单 + framing（如声明需人裁）", "G2：method card 四锚点无占位 + probe verdict PASS/CONDITIONAL（含 output_degeneracy）", "G2.5：method_choice DECIDED+source；G3：最新轮 run_summary+评审五态 PASS/NOT_APPLICABLE；G4：三判定（+submission 附件）；G5/G6：三前置+冻结宏+三审"] },
    { "dot": "rose", "title": "人类决策与双轨", "items": ["人判点：CC1 四问→method_choice→CC2→G4 三判定→package_signoff→解释确认；AI 只呈现证据并原话记录", "lean 停在 G4 结果判定子门（继续迭代不冻结）；submission 追加冻结/论文/G5/G6 与 deadline_hint"] },
    { "dot": "emerald", "title": "机器强制红线", "items": ["require 敏感工件先 derive（code≥G2.5、freeze≥G4、paper≥G5、final≥G6）；manifest 不能自我提门禁", "DECIDED 缺 source 无效；快照须统一运行器执行；血缘 STALE/MISSING 阻断；冻结改数走 解冻→改源→重跑→重冻结"] },
    { "dot": "amber", "title": "循环与回退", "items": ["CC2 选调整/回退 → 返回实验链（lean 内迭代）；备选仅在记录触发条件命中时激活", "稳健性双层：lean 探针 summary 与 submission 报告；结果判定基于计算证据而非口头声明"] }
