  "cards": [
    {
      "dot": "cyan",
      "title": "配置开关（session_config）",
      "items": [
        "interaction_mode：learning/speed；rigor_profile：lean/submission（auto 读取）；兼容旧 mode",
        "artifact_policy 四开关默认 ON · 可选 deadline → advisory deadline_hint"
      ]
    },
    {
      "dot": "rose",
      "title": "宿主速记",
      "items": [
        "Codex/Claude：.codex/.claude/skills 或插件；DSH 0.7.1：仓库为工作区 → .agents/skills 自动发现 32 技能",
        "DSH/Codex 默认不执行 hooks；DSH 可选 cordis.patch.yml（须配 pluginRoot）；python/git 需在 PATH"
      ]
    },
    {
      "dot": "emerald",
      "title": "首轮顺序与隐私",
      "items": [
        "problem-parser → problem-classifier → data-auditor-cleaner → workflow-orchestrator；产物落 planning/parse、classification、workspace/data",
        "框架裁决原话入 framing_decisions.jsonl 或 Qx 账本；.gitignore 隐私守卫 + git worktree 隔离"
      ]
    }
